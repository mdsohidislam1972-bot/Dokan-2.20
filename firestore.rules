rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function getStoreData(storeId) {
      return get(/databases/$(database)/documents/stores/$(storeId)).data;
    }

    function isStoreOwner(storeId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/stores/$(storeId)) &&
        getStoreData(storeId).ownerId == request.auth.uid;
    }

    function getMemberDoc(storeId, uid) {
      return get(/databases/$(database)/documents/stores/$(storeId)/members/$(uid)).data;
    }

    function isActiveStaffMember(storeId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/stores/$(storeId)) &&
        'memberUids' in getStoreData(storeId) &&
        request.auth.uid in getStoreData(storeId).memberUids &&
        exists(/databases/$(database)/documents/stores/$(storeId)/members/$(request.auth.uid)) &&
        getMemberDoc(storeId, request.auth.uid).status == 'Active';
    }

    function isActiveStoreMember(storeId) {
      return isStoreOwner(storeId) || isActiveStaffMember(storeId);
    }

    function hasStorePermission(storeId, permKey) {
      return isStoreOwner(storeId) || (
        isActiveStaffMember(storeId) &&
        'permissions' in getMemberDoc(storeId, request.auth.uid) &&
        permKey in getMemberDoc(storeId, request.auth.uid).permissions &&
        getMemberDoc(storeId, request.auth.uid).permissions[permKey] == true
      );
    }

    function isValidInviteConsumption(inviteCode) {
      let storeId = resource.data.storeId;
      let afterMember = getAfter(/databases/$(database)/documents/stores/$(storeId)/members/$(request.auth.uid)).data;
      let afterStore = getAfter(/databases/$(database)/documents/stores/$(storeId)).data;
      return isSignedIn() &&
        resource.data.status == 'active' &&
        request.time.toMillis() <= resource.data.expiresAt &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'usedByUid', 'usedByEmail', 'usedAt', 'updatedAt']) &&
        request.resource.data.status == 'used' &&
        request.resource.data.usedByUid == request.auth.uid &&
        exists(/databases/$(database)/documents/stores/$(storeId)) &&
        getStoreData(storeId).ownerId != request.auth.uid &&
        existsAfter(/databases/$(database)/documents/stores/$(storeId)/members/$(request.auth.uid)) &&
        afterMember.status == 'Active' &&
        afterMember.inviteCode == inviteCode &&
        request.auth.uid in afterStore.memberUids;
    }

    function isValidInviteJoin(storeId, memberId, newMemberData) {
      let code = newMemberData.inviteCode;
      let inviteBefore = get(/databases/$(database)/documents/invites/$(code)).data;
      let inviteAfter = getAfter(/databases/$(database)/documents/invites/$(code)).data;
      let storeAfter = getAfter(/databases/$(database)/documents/stores/$(storeId)).data;
      return isSignedIn() &&
        request.auth.uid == memberId &&
        exists(/databases/$(database)/documents/stores/$(storeId)) &&
        getStoreData(storeId).ownerId != request.auth.uid &&
        'inviteCode' in newMemberData &&
        code is string &&
        code.matches('^[A-HJ-KM-NP-Z2-9]{8}$') &&
        exists(/databases/$(database)/documents/invites/$(code)) &&
        inviteBefore.storeId == storeId &&
        inviteBefore.status == 'active' &&
        request.time.toMillis() <= inviteBefore.expiresAt &&
        inviteAfter.status == 'used' &&
        inviteAfter.usedByUid == request.auth.uid &&
        newMemberData.userId == request.auth.uid &&
        newMemberData.status == 'Active' &&
        newMemberData.roleLabel == inviteBefore.roleLabel &&
        newMemberData.roleLabel != 'Owner' &&
        newMemberData.role != 'owner' &&
        newMemberData.role == inviteBefore.roleLabel.lower() &&
        newMemberData.permissionLevel == inviteBefore.permissionLevel &&
        newMemberData.permissions == inviteBefore.permissions &&
        newMemberData.invitedBy == inviteBefore.createdByUid &&
        request.auth.uid in storeAfter.memberUids;
    }

    function isValidStoreSelfJoin(storeId) {
      let afterMember = getAfter(/databases/$(database)/documents/stores/$(storeId)/members/$(request.auth.uid)).data;
      let code = afterMember.inviteCode;
      let inviteBefore = get(/databases/$(database)/documents/invites/$(code)).data;
      let inviteAfter = getAfter(/databases/$(database)/documents/invites/$(code)).data;
      return isSignedIn() &&
        request.auth.uid != resource.data.ownerId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'updatedAt']) &&
        (
          (
            'memberUids' in resource.data &&
            request.resource.data.memberUids.hasAll(resource.data.memberUids) &&
            request.resource.data.memberUids.size() <= resource.data.memberUids.size() + 1 &&
            request.resource.data.memberUids.hasOnly(resource.data.memberUids.concat([request.auth.uid]))
          ) ||
          (
            !('memberUids' in resource.data) &&
            request.resource.data.memberUids == [request.auth.uid]
          )
        ) &&
        request.auth.uid in request.resource.data.memberUids &&
        existsAfter(/databases/$(database)/documents/stores/$(storeId)/members/$(request.auth.uid)) &&
        afterMember.status == 'Active' &&
        'inviteCode' in afterMember &&
        code is string &&
        code.matches('^[A-HJ-KM-NP-Z2-9]{8}$') &&
        exists(/databases/$(database)/documents/invites/$(code)) &&
        inviteBefore.storeId == storeId &&
        inviteBefore.status == 'active' &&
        request.time.toMillis() <= inviteBefore.expiresAt &&
        inviteAfter.status == 'used' &&
        inviteAfter.usedByUid == request.auth.uid;
    }

    // User document: maps account to their active store
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Global Invites collection (8-char unique code lookup for staff joining)
    match /invites/{inviteCode} {
      // Signed-in non-members may fetch only a single invite document by exact code
      allow get: if isSignedIn();
      // Only the store owner can query/list invites for their store
      allow list: if isSignedIn() && isStoreOwner(resource.data.storeId);
      // Only store owner can generate a valid active invite for their store
      allow create: if isSignedIn() &&
        isStoreOwner(request.resource.data.storeId) &&
        request.resource.data.createdByUid == request.auth.uid &&
        request.resource.data.code == inviteCode &&
        inviteCode.matches('^[A-HJ-KM-NP-Z2-9]{8}$') &&
        request.resource.data.status == 'active' &&
        request.resource.data.roleLabel != 'Owner' &&
        request.resource.data.roleLabel.lower() != 'owner';
      // Owner can cancel/update, or joining user can atomically mark an active unexpired invite used
      allow update: if isSignedIn() && (
        isStoreOwner(resource.data.storeId) ||
        isValidInviteConsumption(inviteCode)
      );
      // Invites are cancelled rather than deleted
      allow delete: if isSignedIn() && isStoreOwner(resource.data.storeId);
    }

    // Store root document
    match /stores/{storeId} {
      // First user who creates the store becomes owner
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      // Owner or Active member only (removed members get nothing)
      allow read: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        (
          'memberUids' in resource.data &&
          request.auth.uid in resource.data.memberUids &&
          exists(/databases/$(database)/documents/stores/$(storeId)/members/$(request.auth.uid)) &&
          getMemberDoc(storeId, request.auth.uid).status == 'Active'
        )
      );
      // Only owner can update store settings, except joining staff appending only their own UID via valid invite
      allow update: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        isValidStoreSelfJoin(storeId)
      );
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      // Members subcollection
      match /members/{memberId} {
        allow read: if isActiveStoreMember(storeId);
        // Only owner can add staff, or joining user creating their own member record matching an active invite
        allow create: if isStoreOwner(storeId) || isValidInviteJoin(storeId, memberId, request.resource.data);
        // Only owner can update member role/level/permissions/status (and owner cannot be removed or demoted),
        // or a previously Removed member can rejoin with a new valid owner-issued invite
        allow update: if (
          isStoreOwner(storeId) &&
          (
            memberId != getStoreData(storeId).ownerId ||
            (
              request.resource.data.roleLabel == 'Owner' &&
              request.resource.data.role == 'owner' &&
              request.resource.data.status == 'Active'
            )
          )
        ) || (
          isSignedIn() &&
          request.auth.uid == memberId &&
          resource.data.status == 'Removed' &&
          isValidInviteJoin(storeId, memberId, request.resource.data)
        );
        // Member documents are kept for transaction audit trail (status = Removed)
        allow delete: if false;
      }

      // Meta counters for sequential invoice/payment numbering
      match /meta/{counterId} {
        allow read, write: if isActiveStoreMember(storeId);
      }

      // Products subcollection
      match /products/{productId} {
        allow read: if hasStorePermission(storeId, 'view_stock') ||
          hasStorePermission(storeId, 'sell') ||
          hasStorePermission(storeId, 'add_edit_products') ||
          hasStorePermission(storeId, 'reports') ||
          hasStorePermission(storeId, 'suppliers_and_purchases');
        allow create: if hasStorePermission(storeId, 'add_edit_products') &&
          request.resource.data.stock >= 0;
        allow update: if (
            hasStorePermission(storeId, 'add_edit_products') &&
            request.resource.data.stock >= 0
          ) || (
            hasStorePermission(storeId, 'sell') &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'updatedAt']) &&
            request.resource.data.stock >= 0 &&
            request.resource.data.stock <= resource.data.stock
          ) || (
            hasStorePermission(storeId, 'suppliers_and_purchases') &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'updatedAt']) &&
            request.resource.data.stock >= resource.data.stock
          );
        allow delete: if isStoreOwner(storeId);
      }

      // Sales subcollection
      match /sales/{saleId} {
        allow read: if hasStorePermission(storeId, 'history') ||
          hasStorePermission(storeId, 'reports') ||
          hasStorePermission(storeId, 'cash_and_bank');
        allow create: if hasStorePermission(storeId, 'sell') &&
          request.resource.data.soldBy == request.auth.uid;
        allow update, delete: if isStoreOwner(storeId);
      }

      // Customers (Baki credit ledger) subcollection
      match /customers/{customerId} {
        allow read: if hasStorePermission(storeId, 'customers_and_baki') ||
          hasStorePermission(storeId, 'receive_payment') ||
          hasStorePermission(storeId, 'sell') ||
          hasStorePermission(storeId, 'reports');
        allow create, delete: if hasStorePermission(storeId, 'customers_and_baki');
        allow update: if hasStorePermission(storeId, 'customers_and_baki') ||
          (
            hasStorePermission(storeId, 'receive_payment') &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentBalance', 'updatedAt'])
          ) ||
          (
            hasStorePermission(storeId, 'sell') &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentBalance', 'updatedAt'])
          );
      }

      // Payments subcollection (Receiving customer baki payment)
      match /payments/{paymentId} {
        allow read: if hasStorePermission(storeId, 'receive_payment') ||
          hasStorePermission(storeId, 'reports') ||
          hasStorePermission(storeId, 'cash_and_bank') ||
          (hasStorePermission(storeId, 'customers_and_baki') && hasStorePermission(storeId, 'history'));
        allow create, update: if hasStorePermission(storeId, 'receive_payment');
        allow delete: if isStoreOwner(storeId);
      }

      // Suppliers subcollection
      match /suppliers/{supplierId} {
        allow read: if hasStorePermission(storeId, 'suppliers_and_purchases') ||
          hasStorePermission(storeId, 'pay_supplier') ||
          hasStorePermission(storeId, 'reports');
        allow create, delete: if hasStorePermission(storeId, 'suppliers_and_purchases');
        allow update: if hasStorePermission(storeId, 'suppliers_and_purchases') ||
          (
            hasStorePermission(storeId, 'pay_supplier') &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance', 'updatedAt'])
          );
      }

      // Purchases subcollection
      match /purchases/{purchaseId} {
        allow read: if hasStorePermission(storeId, 'suppliers_and_purchases') ||
          hasStorePermission(storeId, 'reports') ||
          hasStorePermission(storeId, 'cash_and_bank');
        allow create, update: if hasStorePermission(storeId, 'suppliers_and_purchases');
        allow delete: if isStoreOwner(storeId);
      }

      // Purchase returns subcollection
      match /purchaseReturns/{returnId} {
        allow read: if hasStorePermission(storeId, 'suppliers_and_purchases') ||
          hasStorePermission(storeId, 'reports');
        allow create, update: if hasStorePermission(storeId, 'suppliers_and_purchases');
        allow delete: if isStoreOwner(storeId);
      }

      // Supplier Payments subcollection
      match /supplierPayments/{paymentId} {
        allow read: if hasStorePermission(storeId, 'pay_supplier') ||
          hasStorePermission(storeId, 'suppliers_and_purchases') ||
          hasStorePermission(storeId, 'reports') ||
          hasStorePermission(storeId, 'cash_and_bank');
        allow create, update: if hasStorePermission(storeId, 'pay_supplier');
        allow delete: if isStoreOwner(storeId);
      }

      // Health fix logs subcollection (Owner only)
      match /healthFixLogs/{logId} {
        allow read, create: if isStoreOwner(storeId);
        allow update, delete: if false;
      }

      // Accounts subcollection (Cash, Bank, Wallet)
      match /accounts/{accountId} {
        allow read, create: if hasStorePermission(storeId, 'cash_and_bank');
        // Only owner can update or archive an account
        allow update: if isStoreOwner(storeId);
        allow delete: if false; // Accounts are archived, never permanently deleted
      }

      // Account Adjustments subcollection (Immutable audit log, Owner only write)
      match /accountAdjustments/{adjustmentId} {
        allow read: if hasStorePermission(storeId, 'cash_and_bank');
        allow create: if isStoreOwner(storeId);
        allow update, delete: if false;
      }

      // Expenses subcollection
      match /expenses/{expenseId} {
        allow read: if hasStorePermission(storeId, 'expenses_and_other_income') ||
          hasStorePermission(storeId, 'reports') ||
          hasStorePermission(storeId, 'cash_and_bank');
        allow create, update: if hasStorePermission(storeId, 'expenses_and_other_income');
        allow delete: if isStoreOwner(storeId);
      }

      // Other Income subcollection
      match /otherIncomes/{incomeId} {
        allow read: if hasStorePermission(storeId, 'expenses_and_other_income') ||
          hasStorePermission(storeId, 'reports') ||
          hasStorePermission(storeId, 'cash_and_bank');
        allow create, update: if hasStorePermission(storeId, 'expenses_and_other_income');
        allow delete: if isStoreOwner(storeId);
      }

      // Categories subcollection
      match /categories/{categoryId} {
        allow read: if hasStorePermission(storeId, 'expenses_and_other_income') ||
          hasStorePermission(storeId, 'reports');
        allow write: if hasStorePermission(storeId, 'expenses_and_other_income');
      }

      // Store Notes subcollection
      match /notes/{noteId} {
        allow read, write: if hasStorePermission(storeId, 'notes');
      }
    }
  }
}
